    <!-- http://qudt.org/schema/qudt/Unit -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Unit">
        <rdfs:label>Unit</rdfs:label>
        <skos:definition xml:lang="en">A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). 
For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures).  Any measurement of the length can be expressed as a number multiplied by the unit meter. 
More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  $Q = nU$.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/STEEL_0000000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/STEEL_0000000">
        <rdfs:label xml:lang="en">root node</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020108 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020108">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0023002"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">relational property</rdfs:label>
        <skos:definition xml:lang="en">a facetted property that describes the relation between two  (maybe more) bearers.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020216 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020216">
        <rdfs:label xml:lang="en">DEPRECATED order scale value</rdfs:label>
        <skos:definition xml:lang="de">DEPRECATED Mögliche Werte der charakteristischen Länge, über die strukturelle Zusammenhänge in einem Material bestehen bleiben</skos:definition>
        <skos:definition xml:lang="en">DEPRECATED possible values of characteristic length over which structural correlations persist in a material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020265 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <rdfs:label xml:lang="en">property</rdfs:label>
        <skos:definition xml:lang="en">property is a collection class for entities that are either qualites (represent a state) or realizable entities (represent a behavior)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <rdfs:label xml:lang="en">facetted property</rdfs:label>
        <skos:definition xml:lang="en">an specifically dependent continuant that is giving more detail to an other property or about its bearer</skos:definition>
    </owl:Class>
    


