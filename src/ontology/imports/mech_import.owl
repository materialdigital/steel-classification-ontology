        <skos:definition xml:lang="en">DEPRECATED periodic arrangement of structural features of virtually all entities</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED periodische Anordnung struktureller Merkmale praktisch aller Entitäten</skos:definition>
        <skos:definition xml:lang="en">periodic arrangement of structural features of virtually all entities</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020242 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020242">
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED no range order</rdfs:label>
