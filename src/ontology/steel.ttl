###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type owl:Class ;
                                   rdfs:label "Unit" ;
                                   skos:definition """A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). 
For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures).  Any measurement of the length can be expressed as a number multiplied by the unit meter. 
More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  $Q = nU$."""@en .


###  https://w3id.org/pmd/STEEL_0000000
<https://w3id.org/pmd/STEEL_0000000> rdf:type owl:Class ;
                                     rdfs:label "root node"@en .


###  https://w3id.org/pmd/co/PMD_0020108
<https://w3id.org/pmd/co/PMD_0020108> rdf:type owl:Class ;
                                      rdfs:subClassOf [ owl:intersectionOf ( <https://w3id.org/pmd/co/PMD_0023002>
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <https://w3id.org/pmd/co/PMD_0025999> ;
                                                                               owl:someValuesFrom obo:BFO_0000004
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                      rdfs:label "relational property"@en ;
                                      skos:definition "a facetted property that describes the relation between two  (maybe more) bearers."@en .


###  https://w3id.org/pmd/co/PMD_0020216
<https://w3id.org/pmd/co/PMD_0020216> rdf:type owl:Class ;
                                      rdfs:label "DEPRECATED order scale value"@en ;
                                      skos:definition "DEPRECATED Mögliche Werte der charakteristischen Länge, über die strukturelle Zusammenhänge in einem Material bestehen bleiben"@de ,
                                                      "DEPRECATED possible values of characteristic length over which structural correlations persist in a material"@en .


###  https://w3id.org/pmd/co/PMD_0020265
<https://w3id.org/pmd/co/PMD_0020265> rdf:type owl:Class ;
                                      rdfs:subClassOf obo:BFO_0000020 ;
                                      rdfs:label "property"@en ;
                                      skos:definition "property is a collection class for entities that are either qualites (represent a state) or realizable entities (represent a behavior)"@en .


###  https://w3id.org/pmd/co/PMD_0023002
<https://w3id.org/pmd/co/PMD_0023002> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020265> ;
                                      rdfs:label "facetted property"@en ;
                                      skos:definition "an specifically dependent continuant that is giving more detail to an other property or about its bearer"@en .


